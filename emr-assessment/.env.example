# Anthropic (server only, never exposed to the browser)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# HubSpot Forms API
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=

# "Book a personalized demo" link. Gaps are appended as a query parameter.
DEMO_URL=https://careficient.com/request-a-demo
# Optional: name of the query parameter that carries the booking notes (default "notes")
DEMO_NOTES_PARAM=notes

# Google Analytics 4 measurement ID (G-XXXXXXX)
GA4_ID=

# Public site URL, used for share links, Open Graph images and the PDF QR code
SITE_URL=http://localhost:3000

# Optional: "Email me this report" via Resend. Without these the button opens the visitor's mail app.
RESEND_API_KEY=
EMAIL_FROM=
